{
  "name": "adobo-guild-site",
  "version": "2.0.0",
  "private": true,
  "description": "Adobo Guild — Where Winds Meet community site. Next.js + TypeScript migration of the original static site.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "node ./scripts/serve-export.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,css,json,md}\"",
    "convert-images": "node ./scripts/convert-images.js",
    "generate-og-image": "node ./scripts/generate-og-image.js",
    "generate-member-og": "node ./scripts/generate-member-og.js",
    "check-assets": "node ./scripts/check-assets.js",
    "test:e2e": "playwright test",
    "prepare": "husky install"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.13",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.3.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^8.0.0",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "npx prettier --write",
      "npx eslint --fix"
    ],
    "*.{css,json,md}": [
      "npx prettier --write"
    ]
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
