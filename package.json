{
  "name": "adobo-guild-site",
  "version": "1.0.0",
  "description": "Tools for generating responsive WebP images for the Adobo Guild site",
  "scripts": {
    "convert-images": "node ./scripts/convert-images.js",
    "format": "prettier --write \"**/*.{js,css,html,json,md}\"",
    "lint": "eslint . --ext .js",
    "prepare": "husky install"
  },
  "dependencies": {
    "sharp": "^0.32.0"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^8.0.0",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4"
  },
  "lint-staged": {
    "*.js": [
      "npx prettier --write",
      "npx eslint --fix"
    ],
    "*.{css,html,md}": [
      "npx prettier --write"
    ],
    "*.json": [
      "npx prettier --write"
    ]
  }
}
